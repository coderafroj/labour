# ==============================================================================
# 🚀 LABOUR CONNECT - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================

# 1. APPWRITE FRONTEND KEYS (Must start with VITE_)
VITE_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=your-project-id-here

# 2. APPWRITE DATABASE & RESOURCES (Optional - Defaults pre-configured)
VITE_APPWRITE_DATABASE_ID=labourconnect
VITE_APPWRITE_ADMIN_TEAM_ID=admins
VITE_APPWRITE_PHOTOS_BUCKET_ID=labourer-photos

# 3. APPWRITE FUNCTION IDs (Optional - Defaults pre-configured)
VITE_APPWRITE_FN_CREATE_ORDER=create-razorpay-order
VITE_APPWRITE_FN_VERIFY_PAYMENT=verify-razorpay-payment
VITE_APPWRITE_FN_GET_CONTACT=get-labourer-contact

# 4. RAZORPAY PAYMENT GATEWAY (Public Key only for browser)
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id

# 5. BACKEND SETUP SCRIPT ONLY (Used once by 'npm run setup:appwrite')
APPWRITE_API_KEY=your-server-api-key-with-databases-storage-teams-write-scopes
