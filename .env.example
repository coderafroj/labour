# ---- Frontend (Vite reads only VITE_* keys, safe to expose in the browser) ----
VITE_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=your-project-id
VITE_APPWRITE_DATABASE_ID=labourconnect
VITE_APPWRITE_ADMIN_TEAM_ID=admins
VITE_APPWRITE_PHOTOS_BUCKET_ID=labourer-photos

# Function IDs — only change these if you name your deployed Functions
# something other than the defaults below.
VITE_APPWRITE_FN_CREATE_ORDER=create-razorpay-order
VITE_APPWRITE_FN_VERIFY_PAYMENT=verify-razorpay-payment
VITE_APPWRITE_FN_GET_CONTACT=get-labourer-contact

# Razorpay PUBLIC key only (starts with rzp_). The secret key must never
# go here — it only lives in the Appwrite Function environment variables.
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id

# ---- Used only by scripts/setup-appwrite.js (never shipped to the browser) ----
APPWRITE_API_KEY=your-server-api-key-with-databases-storage-teams-write-scopes
